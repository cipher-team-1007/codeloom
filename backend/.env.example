# ==============================================================================
# ACCESSIFIX ENGINE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in accessifix-engine/ to configure local credentials.
# DO NOT COMMIT REAL API KEYS OR SECRETS TO GIT.
# ==============================================================================

# LLM Provider Configuration
# Supported providers: groq | nvidia | openrouter | gemini | openai | anthropic | ollama | mock
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# API Keys (Provide key for selected provider)
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1


# Dry Run Mode: When true or when no API key exists, falls back to MockProvider safely.
DRY_RUN=false

# GitHub OAuth & Publisher Configuration
# You must create a GitHub OAuth App to publish fixes.
# Go to Developer Settings > OAuth Apps > New OAuth App.
# Set Authorization callback URL to: http://localhost:8000/api/v1/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/github/callback
GITHUB_FRONTEND_REDIRECT_URL=http://localhost:8000/audit.html

# Localhost Scanning Security Boundary
ALLOW_LOCALHOST_SCAN=true
